# NeuroLens Environment Variables Template
# Copy this file to .env and fill in your values
# NEVER commit the actual .env file

# Hugging Face Hub (for model downloads)
HF_TOKEN=your_huggingface_token_here

# Weights & Biases (optional experiment tracking)
WANDB_API_KEY=your_wandb_key_here
WANDB_PROJECT=neurolens
WANDB_ENTITY=your_username

# MLflow (optional experiment tracking)
MLFLOW_TRACKING_URI=http://localhost:5000

# Frontend (if using separate backend API)
VITE_API_BASE_URL=http://localhost:3001/api
PORT=3001

# Database (if needed for frontend)
DATABASE_URL=postgresql://user:pass@localhost:5432/neurolens

# Redis (if needed for caching)
REDIS_URL=redis://localhost:6379

# GPU/Compute
CUDA_VISIBLE_DEVICES=0
PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:128echo 
