# Local DragonForge API and PostgreSQL settings.
# Replace every placeholder before starting the API; do not use these example values.
POSTGRES_PASSWORD=replace-with-a-random-url-safe-password
DRAGONFORGE_DATABASE_URL=postgresql+psycopg://dragonforge:replace-with-a-random-url-safe-password@localhost:5432/dragonforge
DRAGONFORGE_SESSION_SECRET=replace-with-at-least-32-random-characters
DRAGONFORGE_BOOTSTRAP_TOKEN=replace-with-at-least-32-random-characters
DRAGONFORGE_TOTP_ENCRYPTION_KEY=replace-with-a-generated-fernet-key
DRAGONFORGE_SESSION_COOKIE_SECURE=false
DRAGONFORGE_ALLOWED_ORIGINS=["http://localhost:5173"]
